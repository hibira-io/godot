; Engine configuration file.
; Only for developing the addon and running tests/; games copy addons/hibira.

config_version=5

[application]

config/name="Hibira Realtime"
config/description="Pusher Channels protocol client for Godot 4, for Hibira and other Pusher-compatible servers."
config/features=PackedStringArray("4.3")
config/icon="res://addons/hibira/icon.svg"
run/main_scene="res://addons/hibira/demo/playground.tscn"

[editor_plugins]

enabled=PackedStringArray("res://addons/hibira/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
